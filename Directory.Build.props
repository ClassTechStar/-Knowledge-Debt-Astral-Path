<?xml version="1.0" encoding="utf-8"?>
<!--
  解决方案级统一元数据（单一事实来源）
  依据《技术方案》首部「项目名称规范」与《四人团队分工方案》§8.2：

    全称     知债：星穹学途（Knowledge Debt: Astral Path）   → 对外材料、产品名、程序集产品信息
    中文简称 知债：星穹学途                                  → 正文叙述、章节标题、图表标签
    英文标识 AstralPath                                      → 命名空间、解决方案名、包名、镜像名、数据库名、域名

  说明：各 .csproj 不再重复声明这些属性；如需按项目覆盖，在该项目的 PropertyGroup 中单独设置即可。
-->
<Project>

  <PropertyGroup>
    <!-- 产品与归属 -->
    <Product>知债：星穹学途（Knowledge Debt: Astral Path）</Product>
    <AssemblyTitle>知债：星穹学途（Knowledge Debt: Astral Path）</AssemblyTitle>
    <Company>知债：星穹学途</Company>
    <Authors>知债：星穹学途四人团队（P1 产品与教育伦理 / P2 算法与后端 / P3 数据与评测 / P4 客户端与体验）</Authors>
    <Description>跨课程知识债诊断与修复智能体（AstralPath）—— BASELINE 契约 + 受约束智能体体系 + 跨端客户端。</Description>
    <Copyright>© 2026 知债：星穹学途（Knowledge Debt: Astral Path）</Copyright>

    <!-- 版本与仓库（英文标识 AstralPath 用于包名/仓库名场景） -->
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <RepositoryUrl>https://github.com/ClassTechStar/-Knowledge-Debt-Astral-Path</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- 产物与语言基线 -->
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
