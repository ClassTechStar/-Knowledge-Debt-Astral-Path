#     既不进版本库，也不应上传到公开仓库。
materials-uploads/
**/materials-uploads/
*.pdf
*.PDF
*.epub
*.docx
*.pptx
*.zip

# OCR 运行时（本地虚拟环境与语言数据）
tools/ocr-venv/
tools/tessdata/
*.traineddata
_smoke_tmp/
astralpath_smoke/

**/__pycache__/
*.py[cod]

# 运行时/临时
*.log
*.tmp
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# 安装包：dist 中的 Setup exe 走 Git LFS；发布输出与 staging 不入库
deploy/win-install/publish-api/
deploy/win-install/publish-desktop/
deploy/win-install/AstralPath-Setup/
materials/ocr-debug/
**/ocr-debug/

# Android 构建缓存与中间产物
