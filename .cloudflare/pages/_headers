# Cloudflare Pages 响应头配置 · 知债：星穹学途 v2.2.0
# 依据：deploy/monolith-web/index.html 零外部 API 调用，纯静态 + 相对路径 WASM
# 关键点：Tesseract WASM 需要正确的 MIME 与跨源隔离，否则 SharedArrayBuffer 会失败

/*
  # 允许跨源隔离，使 WASM SIMD / 多线程路径可用（需 HTTPS，Cloudflare 默认满足）
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: cross-origin

# 基础安全头
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
X-Frame-Options: SAMEORIGIN
Permissions-Policy: geolocation=(), microphone=(), camera=()

# 静态资源长期缓存（带hash 的引擎文件本身已版本化目录结构）
/ocr-engine/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 不缓存，保证更新即时生效
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
