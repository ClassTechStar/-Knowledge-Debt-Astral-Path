<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstralPath.Core\AstralPath.Core.csproj" />
    <ProjectReference Include="..\AstralPath.Contracts\AstralPath.Contracts.csproj" />
    <ProjectReference Include="..\AstralPath.Graph\AstralPath.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql：PostgreSQL 官方 .NET 驱动（生产级持久化） -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- 配置绑定与 DI 抽象（用于按配置切换 memory / postgres 模式） -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
