<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    知债：星穹学途 客户端主题（方案 §41.0 / 附录 X）
    - 应用外壳：浅色（#F5F7FA 底 + 白卡）
    - 图谱画布：深色（#0F0F1A，§41.1 指定）
    - 债边/掌握度配色严格取自方案，并提供色盲安全替代
    以 Styles 为根：既承载资源字典（Styles.Resources），也承载全局样式。
  -->

  <Styles.Resources>
    <!-- ── 基础色板 ─────────────────────────────────────────── -->
    <Color x:Key="AppBackgroundColor">#F5F7FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F5F9</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="TextPrimaryColor">#1E293B</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryHoverColor">#2563EB</Color>
    <Color x:Key="GraphCanvasColor">#0F0F1A</Color>

    <!-- 债边状态色（方案 §12.2） -->
    <Color x:Key="DebtOpenColor">#E53935</Color>
    <Color x:Key="DebtRepairingColor">#FB8C00</Color>
    <Color x:Key="DebtClearedColor">#43A047</Color>
    <Color x:Key="DebtDroppedColor">#9E9E9E</Color>
    <Color x:Key="PrereqNormalColor">#BDBDBD</Color>

    <!-- 掌握度 band：色盲安全三色（方案 附录 X：不靠颜色单独区分） -->
    <Color x:Key="BandHighColor">#1B9E77</Color>
    <Color x:Key="BandMidColor">#D95F02</Color>
    <Color x:Key="BandLowColor">#7570B3</Color>
    <Color x:Key="WarnColor">#D97706</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="GraphCanvasBrush" Color="{StaticResource GraphCanvasColor}" />
    <SolidColorBrush x:Key="DebtOpenBrush" Color="{StaticResource DebtOpenColor}" />
    <SolidColorBrush x:Key="DebtRepairingBrush" Color="{StaticResource DebtRepairingColor}" />
    <SolidColorBrush x:Key="DebtClearedBrush" Color="{StaticResource DebtClearedColor}" />
    <SolidColorBrush x:Key="DebtDroppedBrush" Color="{StaticResource DebtDroppedColor}" />
    <SolidColorBrush x:Key="PrereqNormalBrush" Color="{StaticResource PrereqNormalColor}" />
    <SolidColorBrush x:Key="BandHighBrush" Color="{StaticResource BandHighColor}" />
    <SolidColorBrush x:Key="BandMidBrush" Color="{StaticResource BandMidColor}" />
    <SolidColorBrush x:Key="BandLowBrush" Color="{StaticResource BandLowColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />

    <!-- ── 尺寸与触达（方案 附录 X.1：桌面 ≥44px、移动 ≥48px） ── -->
    <x:Double x:Key="TouchTargetDesktop">44</x:Double>
    <x:Double x:Key="TouchTargetMobile">48</x:Double>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
  </Styles.Resources>

  <!-- ── 文本层级 ─────────────────────────────────────────── -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ── 卡片 ─────────────────────────────────────────────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- ── 按钮（含最小触达尺寸） ────────────────────────────── -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{StaticResource TouchTargetDesktop}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- 导航项：选中态用左侧色条 + 底色，不依赖颜色单独表意 -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="#E8F0FE" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <!-- 焦点环：2px 可见（方案 附录 X 键盘可达性）。仅对 TemplatedControl 生效。 -->
  <Style Selector=":is(TemplatedControl):focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ── 徽章 / 标签 ──────────────────────────────────────── -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
  </Style>

  <Style Selector="Border.band-high">
    <Setter Property="Background" Value="{StaticResource BandHighBrush}" />
  </Style>
  <Style Selector="Border.band-mid">
    <Setter Property="Background" Value="{StaticResource BandMidBrush}" />
  </Style>
  <Style Selector="Border.band-low">
    <Setter Property="Background" Value="{StaticResource BandLowBrush}" />
  </Style>

  <Style Selector="TextBlock.badge-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 免责页脚 -->
  <Style Selector="TextBlock.disclaimer">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 进度条 -->
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>

</Styles>
