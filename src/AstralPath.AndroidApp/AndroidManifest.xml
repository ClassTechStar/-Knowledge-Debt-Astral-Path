<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    权限最小化：本应用自包含（API 与数据都在 APK 内），只需要网络访问本机回环。
    不申请存储 / 相机 / 位置 / 通讯录等任何敏感权限。

    Activity 不在这里声明：由 MainActivity 上的 [Activity] 特性在构建时合并
    （.NET Android 会在最终清单里生成 com.astralpath.app.MainActivity），
    手写 android:name=".MainActivity" 会指向不存在的 Java 类，反而导致崩溃。
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <application
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:hardwareAccelerated="true"
      android:largeHeap="true"
      android:usesCleartextTraffic="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:theme="@style/Theme.AstralPath" />
</manifest>
