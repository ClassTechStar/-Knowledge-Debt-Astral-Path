<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      知债：星穹学途 · Android 安装程序（方案 §13 / §14）

      架构：与桌面壳**同构的自包含应用**——把 AstralPath.Api（含 wwwroot/index.html）
      跑在 APK 内的本地回环端口上，再用系统 WebView 打开它。
      界面、交互、数据逻辑因此与 Web / Windows 端逐字节一致，且**不依赖电脑**。

      版本下限：minSdk 26 = Android 8.0（用户要求「Android 8.0 及以上」）。
    -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AstralPath.AndroidApp</RootNamespace>
    <AssemblyName>AstralPath.AndroidApp</AssemblyName>

    <ApplicationId>com.astralpath.app</ApplicationId>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
    <ApplicationVersion>13</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <TargetSdkVersion>34</TargetSdkVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>

    <!--
      单个 APK 覆盖主流 ABI：arm64-v8a（新机）/ armeabi-v7a（旧机）/ x86_64（模拟器）。
      构建时按 <AndroidSupportedAbis> 全部打包，产物仍是一个文件。
    -->
    <AndroidSupportedAbis>armeabi-v7a;arm64-v8a;x86_64</AndroidSupportedAbis>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>

    <!--
      不使用 NativeAOT：解释器模式启动更快、体积更小，且与 Debug/Release 行为一致。
      如需启用 AOT（启动更快、体积更大）再单独评估。
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableProfiler>false</AndroidEnableProfiler>
  </PropertyGroup>

  <!-- ASP.NET Core 主机能力：与 AstralPath.Api 共用 Microsoft.AspNetCore.App -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    单一事实源：不复制第二份 wwwroot / 图包，直接引用 Api 工程与仓库根的产物。
    改动只会在一个地方发生，Android 端不可能「落后一版」。
  -->
  <ItemGroup>
    <ProjectReference Include="..\AstralPath.Api\AstralPath.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\AstralPath.Api\wwwroot\**\*">
      <Link>webroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\..\graph-packs\accounting-v1\**\*">
      <Link>graph-packs\accounting-v1\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\..\eval\textbook-questions.json">
      <Link>eval\textbook-questions.json</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\..\tools\ocr_pipeline.py">
      <Link>tools\ocr_pipeline.py</Link>
    </AndroidAsset>
  </ItemGroup>

</Project>
