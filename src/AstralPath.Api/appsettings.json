{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Mode": "postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=astralpath;Username=astralpath;Password=astralpath",
    "VectorDimensions": 1024,
    "AllowMemoryFallback": true,
    "AutoMigrate": true,

    "Snapshot": true,
    "SnapshotDebounceMs": 150,
    "SnapshotKeepBackups": 1,
    "DataDir": ""
  },
  "Security": {
    "RequireAuth": true,
    "EnforceOwnership": true,
    "AllowAnyOrigin": false,
    "CorsOrigins": ""
  }
}
