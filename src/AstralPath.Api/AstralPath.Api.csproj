<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AstralPath.Core\AstralPath.Core.csproj" />
    <ProjectReference Include="..\AstralPath.Graph\AstralPath.Graph.csproj" />
    <ProjectReference Include="..\AstralPath.Contracts\AstralPath.Contracts.csproj" />
    <ProjectReference Include="..\AstralPath.Infrastructure\AstralPath.Infrastructure.csproj" />
    <ProjectReference Include="..\AstralPath.Shared\AstralPath.Shared.csproj" />
    <!-- §19 扩展服务控制器（单一路由来源：单体与独立服务宿主共用） -->
    <ProjectReference Include="..\AstralPath.Services\AstralPath.Services.csproj" />
    <!-- 生产级持久化（可切换 memory / postgres） -->
    <ProjectReference Include="..\AstralPath.Persistence\AstralPath.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\graph-packs\accounting-v1\**\*">
      <Link>graph-packs\accounting-v1\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\tools\ocr_pipeline.py">
      <Link>tools\ocr_pipeline.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\eval\textbook-questions.json">
      <Link>eval\textbook-questions.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
