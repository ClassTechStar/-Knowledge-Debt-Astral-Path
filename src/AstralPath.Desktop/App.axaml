<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AstralPath.Shared.Views"
             x:Class="AstralPath.Desktop.App"
             RequestedThemeVariant="Light">

  <!--
    桌面端应用（方案 §12）
    - 浅色外壳 + Fluent 基础主题；业务样式来自 Shared/Styles/AppTheme.axaml
    - VM → View 由 Shared/Views/ViewLocator 统一解析，两端共用一份映射
  -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AstralPath.Shared/Styles/AppTheme.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <views:ViewLocator />
  </Application.DataTemplates>
</Application>
