<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AstralPath.Desktop</AssemblyName>
    <RootNamespace>AstralPath.Desktop</RootNamespace>
    <Product>知债：星穹学途（Knowledge Debt: Astral Path）</Product>
    <AssemblyTitle>知债：星穹学途（Knowledge Debt: Astral Path）</AssemblyTitle>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <Description>与 Web 端完全一致的桌面壳：WebView2 内嵌演示 UI + 本地 API</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="App.axaml.cs" />
    <Compile Remove="Views/**" />
    <Compile Remove="Demo/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
