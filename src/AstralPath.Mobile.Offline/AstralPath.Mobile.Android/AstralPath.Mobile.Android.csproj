<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationId>com.astralpath.mobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableAot>false</AndroidEnableAot>
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AstralPath.Mobile\App.axaml.cs" />
    <Compile Include="..\AstralPath.Mobile\MainActivity.cs" />
    <Compile Include="..\AstralPath.Mobile\Views\**\*.cs" />
    <Compile Include="..\AstralPath.Mobile\ViewModels\**\*.cs" />
    <Compile Include="..\AstralPath.Mobile\Services\**\*.cs" />
    <Compile Include="..\AstralPath.Mobile\Data\**\*.cs" />
    <AvaloniaResource Include="..\AstralPath.Mobile\App.axaml" />
    <AndroidResource Include="..\AstralPath.Mobile\Resources\**\*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\AstralPath.Mobile\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstralPath.Core\AstralPath.Core.csproj" />
  </ItemGroup>
</Project>
