<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AstralPath.Shared.Views"
             x:Class="AstralPath.Mobile.App"
             RequestedThemeVariant="Light">

  <!--
    移动端应用（方案 §13）
    - 与桌面共用 Shared 的页面与样式；仅覆盖触达尺寸为 48px（附录 X.1）
  -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AstralPath.Shared/Styles/AppTheme.axaml" />

    <!-- 移动端触达下限 48px（覆盖 Shared 主题里的 44px） -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <views:ViewLocator />
  </Application.DataTemplates>
</Application>
