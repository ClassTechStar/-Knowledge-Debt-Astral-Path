src/AstralPath.Android/local.properties
*.keystore
src/AstralPath.Android/dist/test-shots/

# ── Android 构建（签名材料与中间产物不入库）──────────────────────────────
src/AstralPath.Android/keystore/
src/AstralPath.Android/keystore.properties
src/AstralPath.Android/build-manual/
src/AstralPath.Android/.gradle/
src/AstralPath.Android/local.properties
# 中间输出与测试截图；APK 本体保留在 dist/ 作为交付物
src/AstralPath.Android/dist/*.idsig
src/AstralPath.Android/dist/*.png
src/AstralPath.Android/dist/*.xml
src/AstralPath.Android/dist/test-shots/

# ── 构建产物（Gradle / MSBuild 中间输出不再入库）────────────────────────
# 注：已被历史跟踪的 src/AstralPath.Native/app/build/** 需另行 git rm --cached 清理，
#     本规则至少可阻止**新的**构建产物继续被 git add 进来。
**/app/build/
**/build/
*.dex
.gradle/

# 运行时状态快照（Persistence:DataDir 指到仓库内时）
runtime-state.json
runtime-state.json.bak
runtime-state.json.tmp
**/.astralpath-state/

