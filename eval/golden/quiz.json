      "expect": { "ok": true, "ci": 3 }
    },
    {
      "id": "G-Q-PARSE-4",
      "description": "数字答案字符串 \"2\" → 下标 2",
      "input": "{\"stem\":\"题干\",\"options\":[\"a\",\"b\",\"c\",\"d\"],\"answer\":\"2\"}",
      "expect": { "ok": true, "ci": 2 }
    },
    {
      "id": "G-Q-PARSE-5",
      "description": "越界数字答案 5 → 钳制为 0",
      "input": "{\"stem\":\"题干\",\"options\":[\"a\",\"b\",\"c\",\"d\"],\"answer\":5}",
      "expect": { "ok": true, "ci": 0 }
    },
    {
      "id": "G-Q-PARSE-6",
      "description": "负数答案 -1 → 钳制为 0",
      "input": "{\"stem\":\"题干\",\"options\":[\"a\",\"b\",\"c\",\"d\"],\"answer\":-1}",
      "expect": { "ok": true, "ci": 0 }
    },
    {
      "id": "G-Q-PARSE-7",
      "description": "选项数不足 4 → null",
      "input": "{\"stem\":\"题干\",\"options\":[\"a\",\"b\",\"c\"],\"answer\":0}",
      "expect": { "ok": false }
    },
    {
      "id": "G-Q-PARSE-8",
      "description": "缺 stem → null",
      "input": "{\"options\":[\"a\",\"b\",\"c\",\"d\"],\"answer\":0}",
      "expect": { "ok": false }
    },
    {
      "id": "G-Q-PARSE-9",
      "description": "空 stem → null",
      "input": "{\"stem\":\"   \",\"options\":[\"a\",\"b\",\"c\",\"d\"],\"answer\":0}",
      "expect": { "ok": false }
    },
    {
      "id": "G-Q-PARSE-10",
