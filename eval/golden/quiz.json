      "input": "```json\n{\"stem\":\"围栏题\",\"options\":[\"a\",\"b\",\"c\",\"d\"],\"answer\":3,\"explain\":\"【拓展】解析\"}\n```",
      "expect": { "ok": true, "ci": 3, "explainPrefix": "【拓展】" }
    },
    {
      "id": "G-Q-PARSE-11",
      "description": "完全非 JSON → null",
      "input": "抱歉我无法生成题目",
      "expect": { "ok": false }
    }
